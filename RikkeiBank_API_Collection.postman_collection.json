	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "admin_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "teller_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "customer_token",
			"value": "",
