						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"customer1\",\n    \"password\": \"customer123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
